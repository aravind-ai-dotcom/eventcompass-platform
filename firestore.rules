rules_version = '2';

// =============================================================================
// PROTOTYPE RULES — NOT PRODUCTION
// Permissive authenticated access for all sko_* collections.
// Deploy: npx firebase-tools deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSkoCollection(name) {
      return name.matches('sko_.*');
    }

    // All sko_* collections — authenticated read/write (prototype only)
    match /{collection}/{doc} {
      allow read, write: if isSignedIn() && isSkoCollection(collection);
    }

    // TechXchange users (separate namespace)
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // TechXchange public catalog — attendees can browse before sign-in
    match /organizations/{org}/events/{event}/sessions/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /organizations/{org}/events/{event}/champions/{doc} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // TechXchange huddles — demo: public read, authenticated writes
    match /organizations/{org}/events/{event}/huddles/{huddleId} {
      allow read: if true;
      allow create: if isSignedIn();
      // Demo: signed-in updates (host edits, cancel, on_my_way counters). App enforces host checks.
      allow update: if isSignedIn();
      allow delete: if false;

      match /responses/{participantId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if false;
      }
    }

    match /organizations/{org}/events/{event}/huddleAnalytics/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // TechXchange participant data + other event subcollections
    match /organizations/{org}/events/{event}/{subcollection}/{doc} {
      allow read, write: if isSignedIn();
    }

    // Legacy unprefixed collections — authenticated read during migration
    match /editions/{doc} { allow read: if isSignedIn(); }
    match /geos/{doc} { allow read: if isSignedIn(); }
    match /markets/{doc} { allow read: if isSignedIn(); }
    match /sellerPersonas/{doc} { allow read: if isSignedIn(); }
    match /speakers/{doc} { allow read: if isSignedIn(); }
    match /contentItems/{doc} { allow read: if isSignedIn(); }
    match /contentClips/{doc} { allow read: if isSignedIn(); }
    match /pulseMetrics/{doc} { allow read: if isSignedIn(); }
    match /pulseQuotes/{doc} { allow read: if isSignedIn(); }
    match /briefs/{doc} { allow read, write: if isSignedIn(); }
    match /podcasts/{doc} { allow read, write: if isSignedIn(); }
    match /seatReservations/{doc} { allow read, write: if isSignedIn(); }
  }
}
